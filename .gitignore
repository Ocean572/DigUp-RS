/Vendor
# Build output
/Vendor/

# Dev runs: their indexes, models and settings
.dev/

# Python: the reference worker's environment
worker/.venv/
server/.venv/
__pycache__/
*.pyc

# Your signing identity for local builds (see build.sh)
.sign-id

# Evals that name your own files
evals/*.local.json

.DS_Store

# The Tauri shell (shell/): Cargo builds and the schemas tauri-build writes
shell/src-tauri/target/
shell/src-tauri/gen/
# What scripts/package-*.sh gather for the packages
shell/src-tauri/helper/
shell/src-tauri/THIRD-PARTY-NOTICES.txt
server/tests/corpus/media/videos/
server/tests/corpus/media/clips/
server/tests/corpus/media/index/
server/tests/corpus/media/models/
server/data/
.pytest_cache/

# Compose bind-mount folders (runtime state, never in git)
deploy/data/
server/tests/corpus/proof/
server/tests/corpus2/media/
.playwright-mcp/

# CI vendor seeding (server.yml): the host cache copied into the build context. Its
# .gitkeep is tracked (the Dockerfile's COPY needs the folder); a copied Vendor never is.
.ci-vendor/*
!.ci-vendor/.gitkeep

# Local agent working notes (see the file itself): a dev aid, not part of the PR
AGENTS.md
.agent-journal.md
session-*.md
ROADMAP.md

# The architecture map (Rust-port survey): a local working doc, not part of the PR
docs/ARCHITECTURE_MAP.md

# ghcr pull-and-run scratch stack (compose state, index, job logs) — same category as deploy/data
deploy/data-ghcr/

# stage-13 app-targets demo scratch stack (compose state, index, job logs)
deploy/data-demo/
# rust test stack bind dirs (compose .rust.yml demo)
deploy/data-rust/

# The Lit + Vite frontend (user brief 2026-11-08): npm install and the build output are
# host artifacts — dist is produced in the Dockerfile's frontend-builder stage and baked
# into the Rust server image; a host copy is only for `npm run dev`/local preview
# (and the `DIGUP_UI_DIST` bind for the fast UI loop).
server/ui/dist/
server/ui/node_modules/

# The Rust workspace (digup-core port): cargo build output. Cargo.lock is committed (the
# workspace ships binaries — cli + server — so the lockfile is part of a reproducible build).
/target/
**/*.rs.bk

# The Rust packaging scripts' staging and artifacts (scripts/rust/package-linux.sh):
# built payloads, like every other package folder, are working artifacts, never git.
dist/

# A box's own compose overlay (the bench stack's local file): it names the machine's real
# paths and mounts — personal data, like every other deploy/data*/ shape. Local-only by design.
deploy/docker-compose.rust.yml

# The CUDA-flavored Vendor tree for the app's GPU payload (Gate B flavor on disk,
# built in the CUDA 11.8 devel container): a working artifact, like Vendor/.
/Vendor-cuda/

# Staged CUDA runtime libraries for the GPU payload (cp -a'd from the CUDA runtime
# base per gpu-handoff.md §4): a working artifact, like Vendor/.
/cuda-libs/
/cuda-libs118/

# CUDA 11.8 flavored Vendor tree + staged libs (the Gate B recipe on disk, built
# in the 11.8 devel container — the flavor the host's 580 driver pairs with):
# working artifacts, like Vendor/.
/Vendor-cuda118/
